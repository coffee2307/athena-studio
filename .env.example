
# PHASE 5 IDENTITY — no credentials are committed, AUTH is OFF by default.
# Supabase Auth origin and publishable key are intentionally public in the browser.
# Turn ON only after migration, RLS isolation, callback, Google and email tests.
NEXT_PUBLIC_ATHENA_AUTH_ENABLED=false
NEXT_PUBLIC_ATHENA_GOOGLE_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site metadata / verified HTTPS origin at public release. Local development may use HTTP.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3182
# Indexing remains blocked even on HTTPS staging until owner signs the final release.
ATHENA_PUBLIC_SITE_RELEASE_APPROVED=false

# Phase 3 intake remains independent and OFF until all requirements are met.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CONTACT_EMAIL=coffee2307@gmail.com
CONTACT_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INQUIRY_RATE_SALT=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Phase 6 is OFF until signed-off Supabase project/workspace/storage migrations and
# real authenticated cross-tenant tests have passed. This flag is server-only.
ATHENA_OPERATIONS_ENABLED=false

# Phase 7 research pilot — OFF by default; operator CLI only, no scheduler.
# Only add HTTPS domains you own or are expressly authorized to check.
ATHENA_SITEPULSE_ENABLED=false
ATHENA_SITEPULSE_APPROVED_HOSTS=
ATHENA_SITEPULSE_TARGETS_JSON=[]
# Local operator-only JSON Lines output (kept outside Git).
ATHENA_SITEPULSE_REPORT_FILE=.qa/sitepulse-results.jsonl
ATHENA_SITEPULSE_MARKDOWN_FILE=.qa/sitepulse-report.md

# Phase 7.1: The consent file must be independently verified by the operator.
# Keep this file private, ignored under .qa/, never commit owner approval records.
ATHENA_SITEPULSE_CONSENT_FILE=.qa/sitepulse-consent.json

# Phase 8C.2: independent identity experiment, OFF by default.
# No Supabase Auth; accounts and sessions are managed by Athena.
# GitHub OAuth login does not imply repository permission: GitHub App is separate.
ATHENA_INDEPENDENT_AUTH_ENABLED=false
ATHENA_IDENTITY_LOCAL_ONLY=false
ATHENA_LOCAL_PASSWORD_AUTH_ENABLED=false
BETTER_AUTH_SECRET=
ATHENA_IDENTITY_DB_PATH=
ATHENA_GOOGLE_OAUTH_CLIENT_ID=
ATHENA_GOOGLE_OAUTH_CLIENT_SECRET=
ATHENA_GITHUB_OAUTH_CLIENT_ID=
ATHENA_GITHUB_OAUTH_CLIENT_SECRET=
ATHENA_GMAIL_SENDER_ENABLED=false
ATHENA_GMAIL_CLIENT_ID=
ATHENA_GMAIL_CLIENT_SECRET=
ATHENA_GMAIL_REFRESH_TOKEN=
ATHENA_GMAIL_SENDER=
# Phase 8C.4 — VPS candidate, NEVER enabled by tracked defaults.
# HTTPS, schema migrations, provider consent and external backup tests required.
ATHENA_VPS_IDENTITY_ENABLED=false
ATHENA_VPS_RELEASE_APPROVED=false
ATHENA_VPS_AUTH_ORIGIN=
# Phase 8C.6 optional SMTP; never send email without explicit owner configuration.
ATHENA_SMTP_ENABLED=false
ATHENA_SMTP_HOST=
ATHENA_SMTP_PORT=
ATHENA_SMTP_SENDER=
ATHENA_SMTP_USERNAME=

# Phase 8B: Staging requires an isolated, owner-approved environment.
# Preflight inventory does not connect to external providers or prove release safety.
ATHENA_STAGING_APPROVED=false
ATHENA_STAGING_ORIGIN=
ATHENA_STAGING_PROJECT_REF=

# Optional GitHub App repository sharing; leave unset until an App and admin allowlist are configured.
ATHENA_GITHUB_APP_ID=
ATHENA_GITHUB_APP_SLUG=
ATHENA_GITHUB_APP_PRIVATE_KEY=
ATHENA_GITHUB_SHARE_ADMIN_EMAILS=
