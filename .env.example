
# PHASE 5 IDENTITY — no credentials are committed, AUTH is OFF by default.
# Supabase Auth origin and publishable key are intentionally public in the browser.
# Turn ON only after migration, RLS isolation, callback, Google and email tests.
NEXT_PUBLIC_ATHENA_AUTH_ENABLED=false
NEXT_PUBLIC_ATHENA_GOOGLE_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Site metadata / verified HTTPS origin at public release. Local development may use HTTP.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Phase 3 intake remains independent and OFF until all requirements are met.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
CONTACT_EMAIL=coffee2307@gmail.com
CONTACT_FROM_EMAIL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INQUIRY_RATE_SALT=
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Phase 6 is OFF until signed-off Supabase project/workspace/storage migrations and
# real authenticated cross-tenant tests have passed. This flag is server-only.
ATHENA_OPERATIONS_ENABLED=false

# Phase 7 research pilot — OFF by default; operator CLI only, no scheduler.
# Only add HTTPS domains you own or are expressly authorized to check.
ATHENA_SITEPULSE_ENABLED=false
ATHENA_SITEPULSE_APPROVED_HOSTS=
ATHENA_SITEPULSE_TARGETS_JSON=[]
# Local operator-only JSON Lines output (kept outside Git).
ATHENA_SITEPULSE_REPORT_FILE=.qa/sitepulse-results.jsonl
ATHENA_SITEPULSE_MARKDOWN_FILE=.qa/sitepulse-report.md

# Phase 7.1: The consent file must be independently verified by the operator.
# Keep this file private, ignored under .qa/, never commit owner approval records.
ATHENA_SITEPULSE_CONSENT_FILE=.qa/sitepulse-consent.json
