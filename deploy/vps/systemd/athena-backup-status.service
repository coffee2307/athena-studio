# Template only. Install after reviewing backup.env and the offsite mount.
[Unit]
Description=Verify Athena encrypted backup freshness and integrity
RequiresMountsFor=/mnt/athena-offsite
ConditionPathIsMountPoint=/mnt/athena-offsite

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/athena/backup.env
Environment=ATHENA_BACKUP_MAX_AGE_HOURS=36
ExecStart=/usr/bin/node /opt/athena/current/deploy/vps/scripts/backup-status.mjs
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/mnt/athena-offsite
