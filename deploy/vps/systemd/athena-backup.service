# Template only. DO NOT enable before restoring an off-host archive successfully.
[Unit]
Description=Athena encrypted off-host PostgreSQL backup
Wants=network-online.target
After=network-online.target docker.service
RequiresMountsFor=/mnt/athena-offsite
ConditionPathIsMountPoint=/mnt/athena-offsite

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/athena/backup.env
WorkingDirectory=/opt/athena/current/deploy/vps
ExecStart=/usr/bin/bash /opt/athena/current/deploy/vps/scripts/backup.sh
TimeoutStartSec=300
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/athena-offsite
